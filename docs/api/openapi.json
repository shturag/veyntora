          "groups": {
            "items": {
              "$ref": "#/components/schemas/GroupOut"
            },
            "title": "Groups",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
