{
  "realm": "veyntora",
  "displayName": "Veyntora",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "de"],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "groups": [
    { "name": "platform-admins", "path": "/platform-admins" },
    { "name": "all-employees", "path": "/all-employees" }
  ],
  "clients": [
    {
      "clientId": "veyntora",
      "name": "Veyntora",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VEY_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${VEY_PUBLIC_BASE_URL}/api/auth/callback"],
      "webOrigins": ["${VEY_PUBLIC_BASE_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true",
        "post.logout.redirect.uris": "${VEY_PUBLIC_BASE_URL}/*"
      },
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "basic"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-veyntora-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "veyntora-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "locale",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "locale",
            "claim.name": "locale",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "veyntora-sync",
      "name": "Veyntora identity sync (read-only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VEY_KEYCLOAK_SYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-veyntora-sync",
      "enabled": true,
      "serviceAccountClientId": "veyntora-sync",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "query-groups"]
      }
    },
    {
      "username": "admin",
      "email": "admin@veyntora.local",
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "groups": ["/platform-admins", "/all-employees"],
      "credentials": [{ "type": "password", "value": "${VEY_DEV_ADMIN_PASSWORD}", "temporary": false }]
    },
    {
      "username": "employee",
      "email": "employee@veyntora.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Employee",
      "enabled": true,
      "groups": ["/all-employees"],
      "credentials": [{ "type": "password", "value": "${VEY_DEV_EMPLOYEE_PASSWORD}", "temporary": false }]
    }
  ]
}
