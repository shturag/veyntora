# Veyntora's .env (ADR 0034). The services it runs on are not set here: on first start the
# Setup page asks for them (http://localhost:3000/setup); later, Admin -> Infrastructure.
#
# `make env` writes this file with new keys. They encrypt the OpenBao tokens on the config
# volume, one key per kind of service, so no service can open another's token. Keep a copy
# safe: without them the settings cannot be read (the passwords stay in OpenBao).
VEY_CONFIG_KEY=
VEY_CONFIG_API_KEY=
VEY_CONFIG_RUNTIME_PUBLIC_KEY=
VEY_CONFIG_RUNTIME_PRIVATE_KEY=

# Optional.
# VEY_PUBLIC_BASE_URL=http://localhost:3000
# VEY_BOOTSTRAP_ADMIN_GROUP=/platform-admins
# Only where no virus scanner can run: documents then show "not scanned".
# VEY_SCAN_REQUIRED=false
# Seeds, imported once; afterwards they are set in the admin console.
# VEY_CLAMAV_ADDRESS=host.docker.internal:3310
# VEY_LANGFUSE_URL=
# VEY_GRAFANA_URL=

# Instead of the Setup page, the services can come from the environment (CI, Helm): see
# scripts/ci-env.sh for the VEY_* variables. The Infrastructure page is then read-only.
